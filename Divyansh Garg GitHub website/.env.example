# Copy to .env.local and fill values. Never commit real credentials.

# ---------------------------------------------------------------------------
# Persistence mode — REQUIRED in every environment
# ---------------------------------------------------------------------------
# Exactly one of: local | supabase. Missing or invalid values fail closed.
#   local    = development only (SQLite + local uploads); never in production.
#   supabase = hosted/production; requires the Supabase variables below.
DATA_MODE=local

# TEST HARNESS ONLY. The Playwright production-build suite sets this to 1 so it
# can run DATA_MODE=local with NODE_ENV=production. Never set it in Vercel,
# staging or any real deployment; leave it unset (or commented out) normally.
# DG_ALLOW_LOCAL_IN_PRODUCTION=1

# ---------------------------------------------------------------------------
# Public site URL — REQUIRED (build-time and runtime)
# ---------------------------------------------------------------------------
# Used for metadataBase, canonical URLs, sitemap.xml and robots.txt.
# There is no localhost SEO fallback: set the real origin before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CV / resume PDF — optional override
# ---------------------------------------------------------------------------
# Default: /uploads/resume/Divyansh_Garg_CV.pdf (the real PDF in public/).
# Keep this same-origin so the browser's native PDF viewer can read and save it.
# NEXT_PUBLIC_CV_URL=/uploads/resume/Divyansh_Garg_CV.pdf

# ---------------------------------------------------------------------------
# Local mode only (DATA_MODE=local; never for production)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=divyansh@example.local
ADMIN_PASSWORD=replace-with-a-strong-local-password
# Used only to salt local rate-limit keys; local session cookies are opaque random IDs.
SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Supabase mode (DATA_MODE=supabase)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined at build time; set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC_, import into a client component,
# commit, or expose in logs. Used at runtime by authenticated server routes.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket names (server-side uploads and signed URLs).
SUPABASE_STORAGE_PUBLIC_BUCKET=media-public
SUPABASE_STORAGE_PRIVATE_BUCKET=media-private

# ---------------------------------------------------------------------------
# Cache revalidation — runtime, used by /api/revalidate
# ---------------------------------------------------------------------------
REVALIDATION_SECRET=replace-with-a-random-token
